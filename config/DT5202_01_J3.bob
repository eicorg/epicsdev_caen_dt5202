var value       = PVUtil.getDouble(pvs[0]); 
var heatMapLow  = PVUtil.getDouble(pvs[1]); 
var heatMapHigh = PVUtil.getDouble(pvs[2]); 


// Original / Default Values
//var minVal = 0.0;    
//var maxVal = 5000.0; 

// Connecting old vars to the new vars
var minVal = heatMapLow;
var maxVal = heatMapHigh;



// Normalizing 0 to 1
var t = (value - minVal) / (maxVal - minVal);
if(t < 0.0) t = 0.0;
if(t > 1.0) t = 1.0;

function lerp(a,b,x){
    return a + (b-a) * x;
}

function lerpColor(c1, c2, x){
    return [
        Math.round(lerp(c1[0], c2[0], x)),
        Math.round(lerp(c1[1], c2[1], x)),
        Math.round(lerp(c1[2], c2[2], x))
    ];
}


// Heatmap Color Stops
var stops = [
    [0,  0, 0],
    [80, 0, 0],
    [200,0, 0], 
    [255,120,0],
    [255,255,0],
    [255,255,255]
];

// Pick which segment we are in
var n = stops.length - 1;
var pos = t * n;
var idx = Math.floor(pos);

if(idx >= n) idx = n -1;

var localT = pos - idx;
var rgb = lerpColor(stops[idx], stops[idx + 1], localT);




widget.setPropertyValue(
    "background_color",
    ColorFontUtil.getColorFromRGB(rgb[0], rgb[1], rgb[2])
);



]]></text>
