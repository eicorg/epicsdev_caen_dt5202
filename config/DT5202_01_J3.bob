var heatMapHigh = PVUtil.getDouble(pvs[2]); 


// Original / Default Values
//var minVal = 0.0;    
//var maxVal = 5000.0; 

// Connecting old vars to the new vars
var minVal = heatMapLow;
var maxVal = heatMapHigh;



// Normalizing 0 to 1
var t = (value - minVal) / (maxVal - minVal);
if(t < 0.0) t = 0.0;
if(t > 1.0) t = 1.0;

function lerp(a,b,x){
    return a + (b-a) * x;
}

function lerpColor(c1, c2, x){
    return [
        Math.round(lerp(c1[0], c2[0], x)),
        Math.round(lerp(c1[1], c2[1], x)),
        Math.round(lerp(c1[2], c2[2], x))
    ];
