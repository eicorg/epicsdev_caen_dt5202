      <name>Polygon_21</name>
      <macros>
        <PV>pva://dt5202_01:J3o[36]</PV>
      </macros>
      <x>56</x>
      <y>108</y>
      <width>30</width>
      <height>31</height>
      <points>
        <point x="30.22163145003782" y="10.40966796875">
        </point>
        <point x="9.700765302104344" y="0.0">
        </point>
        <point x="0.0" y="21.204879760742188">
        </point>
        <point x="20.483033199919888" y="31.257916259765608">
        </point>
        <point x="30.14850975774951" y="10.709667968749983">
        </point>
      </points>
      <line_color>
        <color name="Text" red="0" green="0" blue="0">
        </color>
      </line_color>
      <background_color>
        <color red="102" green="77" blue="179">
        </color>
      </background_color>
      <scripts>
        <script file="EmbeddedJs">
          <text><![CDATA[/* Embedded javascript */
importClass(org.csstudio.display.builder.runtime.script.PVUtil);
importClass(org.csstudio.display.builder.runtime.script.ColorFontUtil);
importClass(org.csstudio.display.builder.runtime.script.ScriptUtil);



var value = PVUtil.getDouble(pvs[0]); 
var minVal = 0.0;
var maxVal = 5000.0;

// Normalizing 0 to 1
var t = (value - minVal) / (maxVal - minVal);
if(t < 0.0) t = 0.0;
if(t > 1.0) t = 1.0;

function lerp(a,b,x){
    return a + (b-a) * x;
}

function lerpColor(c1, c2, x){
    return [
        Math.round(lerp(c1[0], c2[0], x)),
        Math.round(lerp(c1[1], c2[1], x)),
        Math.round(lerp(c1[2], c2[2], x))
    ];
}


// Heatmap Color Stops
var stops = [
    [0,  0, 0],
    [80, 0, 0],
    [200,0, 0], 
    [255,120,0],
    [255,255,0],
    [255,255,255]
];

// Pick which segment we are in
var n = stops.length - 1;
var pos = t * n;
var idx = Math.floor(pos);

if(idx >= n) idx = n -1;

var localT = pos - idx;
var rgb = lerpColor(stops[idx], stops[idx + 1], localT);




widget.setPropertyValue(
    "background_color",
    ColorFontUtil.getColorFromRGB(rgb[0], rgb[1], rgb[2])
);



]]></text>
          <pv_name>$(PV)</pv_name>
        </script>
      </scripts>
