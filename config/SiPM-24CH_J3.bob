      <macros>
        <PV>loc://txt_ch12</PV>
        <HeatMap>loc://heatmap</HeatMap>
        <xxx>pva://dt5202_01:J3o[44]</xxx>
      </macros>
      <x>197</x>
      <y>26</y>
      <width>30</width>
      <height>30</height>
      <line_color>
        <color name="Text" red="0" green="0" blue="0">
        </color>
      </line_color>
      <background_color>
        <color red="102" green="77" blue="179">
        </color>
      </background_color>
      <scripts>
        <script file="EmbeddedJs">
          <text><![CDATA[/* Embedded javascript */
importClass(org.csstudio.display.builder.runtime.script.PVUtil);
importClass(org.csstudio.display.builder.runtime.script.ColorFontUtil);
importClass(org.csstudio.display.builder.runtime.script.ScriptUtil);



var value = PVUtil.getDouble(pvs[0]); 

// Setting Default Values
var minVal = 0.0;    
var maxVal = 5000.0; 

var heatmap = ScriptUtil.findWidgetByName(widget, "HeatMap");

if(heatmap != null){
    var heatmap_min = heatmap.getPropertyValue("minimum");
    var heatmap_max = heatmap.getPropertyValue("maximum");

    // Connecting old vars to the new vars
    var minVal = parseFloat(heatmap_min);
    var maxVal = parseFloat(heatmap_max);
}


// Normalizing 0 to 1
var t = (value - minVal) / (maxVal - minVal);
if(t < 0.0) t = 0.0;
if(t > 1.0) t = 1.0;

function lerp(a,b,x){
    return a + (b-a) * x;
}

function lerpColor(c1, c2, x){
    return [
        Math.round(lerp(c1[0], c2[0], x)),
        Math.round(lerp(c1[1], c2[1], x)),
        Math.round(lerp(c1[2], c2[2], x))
    ];
}


// Heatmap Color Stops
var stops = [
    [0,  0, 0],
    [80, 0, 0],
    [200,0, 0], 
    [255,120,0],
    [255,255,0],
    [255,255,255]
];

// Pick which segment we are in
var n = stops.length - 1;
var pos = t * n;
var idx = Math.floor(pos);

if(idx >= n) idx = n -1;

var localT = pos - idx;
var rgb = lerpColor(stops[idx], stops[idx + 1], localT);




widget.setPropertyValue(
    "background_color",
    ColorFontUtil.getColorFromRGB(rgb[0], rgb[1], rgb[2])
);



]]></text>
          <pv_name>$(PV)</pv_name>
          <pv_name>$(HeatMap)</pv_name>
        </script>
      </scripts>
    </widget>
