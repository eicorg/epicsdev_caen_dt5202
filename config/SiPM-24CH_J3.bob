  <widget type="image" version="2.0.0">
    <name>Image_1</name>
    <pv_name>loc://heatmap</pv_name>
    <x>425</x>
    <width>110</width>
    <height>597</height>
    <background_color>
      <color name="Transparent" red="255" green="255" blue="255" alpha="0">
      </color>
    </background_color>
    <color_map>
      <name>HOT</name>
    </color_map>
    <color_bar>
      <visible>true</visible>
      <bar_size>100</bar_size>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </color_bar>
    <x_axis>
      <visible>false</visible>
      <title></title>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </x_axis>
    <y_axis>
      <visible>false</visible>
      <title></title>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </y_axis>
    <rules>
      <rule name="MinimumRule" prop_id="minimum" out_exp="true">
        <exp bool_exp="pv0==0">
          <expression>0</expression>
        </exp>
        <exp bool_exp="pv0==1">
          <expression>pv1</expression>
        </exp>
        <pv_name>loc://btnAutoMan</pv_name>
        <pv_name>loc://txt_min</pv_name>
      </rule>
      <rule name="MaximumRule" prop_id="maximum" out_exp="true">
        <exp bool_exp="pv0==0">
          <expression>5000</expression>
        </exp>
        <exp bool_exp="pv0==1">
          <expression>pv1</expression>
        </exp>
        <pv_name>loc://btnAutoMan</pv_name>
        <pv_name>loc://txt_max</pv_name>
      </rule>
    </rules>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <interpolation>1</interpolation>
    <color_mode>18</color_mode>
    <minimum>100.0</minimum>
    <maximum>200.0</maximum>
  </widget>
